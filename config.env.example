# ---- Login ----
# Single account: use PAIR_NUMBER or SESSION_ID as before.
# Multiple accounts: comma-separated values are paired by index.
PAIR_NUMBER=
SESSION_ID=
PAIR_NUMBERS=
SESSION_IDS=

# ---- General ----
BOT_NAME=MyBot
# Bot messages: en or fr
BOT_LANG=en
# Command prefix characters. Commands WITHOUT a prefix are ignored.
PREFIX=.
# private = only owner/sudo can use commands, public = everyone
MODE=private
# Extra admins of the bot (numbers, comma separated)
SUDO=
# Optional group moderators (numbers, comma separated)
GROUP_ADMINS=

# ---- Moderation messages (&mention, &warn, &remaining are replaced) ----
WARN_LIMIT=3
ANTILINK_MSG=_Antilink detected &mention kicked_
ANTISPAM_MSG=_Antispam detected &mention kicked_
ANTIWORDS_MSG=_Forbidden word detected &mention kicked_
ANTI_BOT_MESSAGE=&mention removed
# Optional global forbidden words (comma-separated); enable antiword per group to use
ANTIWORDS=
WARN_MESSAGE="⚠️ WARNING ⚠️\n*User:* &mention\n*Warn:* &warn\n*Remaining:* &remaining"
WARN_RESET_MESSAGE=
WARN_KICK_MESSAGE=&mention kicked (warn limit reached)

# ---- Comfort ----
ALWAYS_ONLINE=false
AUTO_STATUS_VIEW=false
REJECT_CALL=false
ANTI_DELETE=false
CMD_REACTION=true
DISABLE_START_MESSAGE=false
DISABLE_BOT=false

# ---- AI (fill at least one) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

SEND_READ=false
# Owner sends a group invite link in private -> bot joins
AJOIN=false
# Auto-approve group join requests (bot must be admin)
APPROVE=false
# git pull at startup (needs a git clone; use with pm2)
AUTO_UPDATE=false

# ---- Tools ----
# remove.bg API key (for .rmbg)
RMBG_KEY=
# Path to a cookies.txt file for yt-dlp (YouTube often blocks server IPs)
YT_COOKIE=
# Legacy alias for YT_COOKIE; YT_COOKIE takes precedence
BING_COOKIE=
# Max size (MB) of downloaded media
MAX_UPLOAD=100
# Brainshop chatbot: bid,key
BRAINSHOP=

# ---- HTTP API ----
# false = bot only | true = bot + API | only = API only
API_MODE=false
PORT=3000
API_KEY=
API_WEBHOOK_URL=

BAILEYS_LOG_LVL=silent
